#!/bin/bash
# P013 harness setup: same interpreter as manual verification,
# user site-packages appended AFTER the command PYTHONPATH so live
# workspace sources always win. Exception: the pydantic live workspace
# needs pydantic-core 2.30.0 (pinned source era) while the shared user
# site carries 2.46.5 (kept healthy for the deepdiff trajectory, whose
# pinned helper imports the installed pydantic dist). The vendored 2.30.0
# wheel (research/013/behavior-data/vendor/) is exposed ONLY under the
# pydantic live workspace, still after the command PYTHONPATH so the
# pinned pydantic source itself always wins. See ensure_python_shim.
EXTRA=":/Users/zhaohuaxiang/Library/Python/3.9/lib/python/site-packages"
case "$PWD" in
  */research/013/behavior-data/outputs/*pydantic*/workspace*)
    EXTRA=":/Users/zhaohuaxiang/ccjjllt/agent_of_gemma_4/research/013/behavior-data/vendor/pydantic-core-2.30.0:$EXTRA" ;;
esac
export PYTHONPATH="${PYTHONPATH}${EXTRA}"
exec "/Library/Developer/CommandLineTools/usr/bin/python3" "$@"
