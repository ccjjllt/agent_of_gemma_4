    "patch": "diff --git a/textdistance/algorithms/edit_based.py b/textdistance/algorithms/edit_based.py\nindex 0a6e02f..3f97c27 100644\n--- a/textdistance/algorithms/edit_based.py\n+++ b/textdistance/algorithms/edit_based.py\n@@ -109,8 +109,8 @@ class Levenshtein(_Base):\n         source:\n         https://github.com/jamesturk/jellyfish/blob/master/jellyfish/_jellyfish.py#L18\n         \"\"\"\n-        rows = len(s1) + 1\n-        cols = len(s2) + 1\n+        rows = len(s2) + 1\n+        cols = len(s1) + 1\n         prev = None\n         cur: Any\n         if numpy:\n@@ -119,14 +119,14 @@ class Levenshtein(_Base):\n             cur = range(cols)\n \n         for r in range(1, rows):\n-            prev, cur = cur, [r] + [0] * (cols - 1)\n+            prev, cur = cur, [r] + [1] * (cols - 1) \n             for c in range(1, cols):\n                 deletion = prev[c] + 1\n-                insertion = cur[c - 1] + 1\n-                dist = self.test_func(s1[r - 1], s2[c - 1])\n+                insertion = cur[c - 1] + 2 \n+                dist = self.test_func(s2[c - 1], s1[r - 1])\n                 edit = prev[c - 1] + (not dist)\n-                cur[c] = min(edit, deletion, insertion)\n-        return int(cur[-1])\n+                cur[c] = max(edit, deletion, insertion)\n+        return int(cur[0])\n \n     def __call__(self, s1: Sequence[T], s2: Sequence[T]) -> int:\n         s1, s2 = self._get_sequences(s1, s2)\n",
