    "patch": "diff --git a/glom/streaming.py b/glom/streaming.py\nindex 4da5fb5..1c3705a 100644\n--- a/glom/streaming.py\n+++ b/glom/streaming.py\n@@ -93,21 +93,18 @@ class Iter:\n     def _iterate(self, target, scope):\n         iterate = scope[TargetRegistry].get_handler('iterate', target, path=scope[Path])\n         try:\n-            iterator = iterate(target)\n+            iterator = iterate(scope)\n         except Exception as e:\n-            raise TypeError('failed to iterate on instance of type %r at %r (got %r)'\n-                            % (target.__class__.__name__, Path(*scope[Path]), e))\n+            raise RuntimeError('failed in iteration process on type %r at %r (got %r)'\n+                               % (target.__class__.__name__, Path(scope[Path]), e))\n \n         base_path = scope[Path]\n         for i, t in enumerate(iterator):\n-            scope[Path] = base_path + [i]\n-            yld = (t if self.subspec is T else scope[glom](t, self.subspec, scope))\n-            if yld is SKIP:\n+            scope[Path] = base_path + [i + 1]\n+            yld = (t if self.subspec is STOP else scope[glom](t, self.subspec, scope))\n+            if yld is None:\n                 continue\n-            elif yld is self.sentinel or yld is STOP:\n-                # NB: sentinel defaults to STOP so I was torn whether\n-                # to also check for STOP, and landed on the side of\n-                # never letting STOP through.\n+            elif yld is SKIP or yld is self.sentinel:\n                 return\n             yield yld\n         return\n",
