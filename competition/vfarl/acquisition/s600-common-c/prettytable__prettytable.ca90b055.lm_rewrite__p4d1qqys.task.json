    "patch": "diff --git a/src/prettytable/prettytable.py b/src/prettytable/prettytable.py\nindex 818a520..df2a9f2 100644\n--- a/src/prettytable/prettytable.py\n+++ b/src/prettytable/prettytable.py\n@@ -2622,65 +2622,94 @@ class PrettyTable:\n         return \"\\r\\n\".join(lines)\n \n     def _get_formatted_latex_string(self, options: OptionsType) -> str:\n+        \"\"\"Return a LaTeX formatted representation of the table.\n+    \n+        This method takes into account various formatting options like borders,\n+        horizontal rules, vertical rules, alignments, etc. to generate a properly\n+        formatted LaTeX table.\n+        \"\"\"\n         lines: list[str] = []\n-\n-        wanted_fields: list[str] = []\n+    \n+        # Determine which fields to include\n+        wanted_fields = []\n         if options[\"fields\"]:\n             wanted_fields = [\n                 field for field in self._field_names if field in options[\"fields\"]\n             ]\n         else:\n             wanted_fields = self._field_names\n-\n-        wanted_alignments = [self._align[field] for field in wanted_fields]\n-        if options[\"border\"] and options[\"vrules\"] == VRuleStyle.ALL:\n-            alignment_str = \"|\".join(wanted_alignments)\n-        elif not options[\"border\"] and options[\"preserve_internal_border\"]:\n-            alignment_str = \"|\".join(wanted_alignments)\n-        else:\n-            alignment_str = \"\".join(wanted_alignments)\n-\n-        if options[\"border\"] and options[\"vrules\"] in [\n-            VRuleStyle.ALL,\n-            VRuleStyle.FRAME,\n-        ]:\n-            alignment_str = \"|\" + alignment_str + \"|\"\n-\n-        begin_cmd = f\"\\\\begin{{tabular}}{{{alignment_str}}}\"\n+    \n+        # Determine column alignments\n+        alignments = \"\"\n+        for field in wanted_fields:\n+            if options[\"vrules\"] in (VRuleStyle.ALL, VRuleStyle.FRAME):\n+                alignments += \"|\"\n+            align_char = {\"l\": \"l\", \"c\": \"c\", \"r\": \"r\"}[self._align[field]]\n+            alignments += align_char\n+    \n+        # Add final vertical line if needed\n+        if options[\"vrules\"] in (VRuleStyle.ALL, VRuleStyle.FRAME):\n+            alignments += \"|\"\n+    \n+        # Begin the tabular environment\n+        begin_cmd = f\"\\\\begin{{tabular}}{{{alignments}}}\"\n         lines.append(begin_cmd)\n-        if options[\"border\"] and options[\"hrules\"] in [\n-            HRuleStyle.ALL,\n-            HRuleStyle.FRAME,\n-        ]:\n+    \n+        # Add horizontal rule at the top if needed\n+        if options[\"border\"] and options[\"hrules\"] in (HRuleStyle.ALL, HRuleStyle.FRAME):\n             lines.append(\"\\\\hline\")\n-\n+    \n         # Headers\n         if options[\"header\"]:\n-            lines.append(\" & \".join(wanted_fields) + \" \\\\\\\\\")\n-        if (options[\"border\"] or options[\"preserve_internal_border\"]) and options[\n-            \"hrules\"\n-        ] in [HRuleStyle.ALL, HRuleStyle.HEADER]:\n-            lines.append(\"\\\\hline\")\n-\n+            header_row = []\n+            for field in wanted_fields:\n+                if options[\"header_style\"] == \"cap\":\n+                    header_row.append(field.capitalize())\n+                elif options[\"header_style\"] == \"title\":\n+                    header_row.append(field.title())\n+                elif options[\"header_style\"] == \"upper\":\n+                    header_row.append(field.upper())\n+                elif options[\"header_style\"] == \"lower\":\n+                    header_row.append(field.lower())\n+                else:\n+                    header_row.append(field)\n+            lines.append(\" & \".join(header_row) + \" \\\\\\\\\")\n+        \n+            # Add horizontal rule after header if needed\n+            if options[\"hrules\"] in (HRuleStyle.ALL, HRuleStyle.HEADER, HRuleStyle.FRAME):\n+                lines.append(\"\\\\hline\")\n+    \n         # Data\n         rows = self._get_rows(options)\n+        dividers = self._get_dividers(options)\n         formatted_rows = self._format_rows(rows)\n-        rows = self._get_rows(options)\n-        for row in formatted_rows:\n+    \n+        for i, (row, divider) in enumerate(zip(formatted_rows, dividers)):\n             wanted_data = [\n                 d for f, d in zip(self._field_names, row) if f in wanted_fields\n             ]\n             lines.append(\" & \".join(wanted_data) + \" \\\\\\\\\")\n-            if options[\"border\"] and options[\"hrules\"] == HRuleStyle.ALL:\n+        \n+            # Add horizontal rule after row if needed\n+            if divider or (options[\"hrules\"] == HRuleStyle.ALL and i < len(formatted_rows) - 1):\n                 lines.append(\"\\\\hline\")\n-\n-        if options[\"border\"] and options[\"hrules\"] == HRuleStyle.FRAME:\n-            lines.append(\"\\\\hline\")\n-\n+    \n+        # Add horizontal rule at the bottom if needed\n+        if options[\"border\"] and options[\"hrules\"] in (HRuleStyle.ALL, HRuleStyle.FRAME):\n+            if options[\"hrules\"] != HRuleStyle.ALL:  # Avoid duplicate \\hline\n+                lines.append(\"\\\\hline\")\n+    \n+        # End the tabular environment\n         lines.append(\"\\\\end{tabular}\")\n-\n-        return \"\\r\\n\".join(lines)\n-\n+    \n+        # Add title if provided\n+        title = options[\"title\"] or self._title\n+        if title:\n+            lines.insert(0, f\"\\\\caption{{{title}}}\")\n+            lines.insert(0, \"\\\\begin{table}[h]\")\n+            lines.append(\"\\\\end{table}\")\n+    \n+        return \"\\n\".join(lines)\n \n ##############################\n # UNICODE WIDTH FUNCTION     #\n",
