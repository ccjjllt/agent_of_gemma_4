  "mechanism_evidence": {
    "trigger": "Update selected documents with a mapping, then use a callback and explicit ID iterator.",
    "base_wrong_behavior": "Mapping payload values are replaced with None, predicate selection is inverted and explicit-ID results are discarded.",
    "production_symbols": "Table.update",
    "causal_change": "Preserve payload/callback channels, selected target IDs and the reported IDs of actual updates.",
    "discriminating_observation": {
      "kind": "explicitly_reviewed_source_bound_inline_execution",
      "description": "from tinydb import TinyDB,where\nfrom tinydb.storages import MemoryStorage\ndb=TinyDB(storage=MemoryStorage);t=db.table('records');ids=t.insert_multiple([{'n':1},{'n':2},{'n':3}]);changed=t.update({'flag':True},where('n')==2)\nprint('mapping_update',changed,t.all());assert changed==[ids[1]] and t.get(doc_id=ids[1])['flag'] is True and 'flag' not in t.get(doc_id=ids[0])\nchanged=t.update(lambda doc:doc.update(n=doc['n']+10),doc_ids=(i for i in [ids[0]]));assert changed==[ids[0]] and t.get(doc_id=ids[0])['n']==11\n"
    },
