    "discriminating_observation": {
      "kind": "explicitly_reviewed_source_bound_inline_execution",
      "description": "from tenacity import Future,RetryError\ncause=ValueError('original')\nfuture=Future(1)\nfuture.set_exception(cause)\nerror=RetryError(future)\ntry:\n error.reraise()\n raise AssertionError('exception was swallowed')\nexcept ValueError as exc:\n assert exc is cause\nsuccess=Future(2)\nsuccess.set_result(3)\nwrapper=RetryError(success)\ntry:\n wrapper.reraise()\n raise AssertionError('RetryError was swallowed')\nexcept RetryError as exc:\n assert exc is wrapper\nprint('reraise_exception_identity_and_wrapper',True)\n"
    },
