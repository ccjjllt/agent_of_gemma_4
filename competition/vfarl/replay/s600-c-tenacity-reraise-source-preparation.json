  "mechanism_evidence": {
    "trigger": "Reraise a retry error after exceptional and successful terminal futures.",
    "base_wrong_behavior": "An exceptional last attempt returns silently; the condition selecting last exception is inverted.",
    "production_symbols": "RetryError.reraise",
