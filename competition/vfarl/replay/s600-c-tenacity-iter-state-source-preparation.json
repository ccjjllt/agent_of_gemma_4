      "description": "from tenacity import Retrying,IterState\nimport threading\ncontroller=Retrying()\nstate=controller.iter_state\nprint('iter_state_type',type(state).__name__)\nassert isinstance(state,IterState) and controller.iter_state is state\nother=[]\ndef read_other():\n value=controller.iter_state\n other.append((isinstance(value,IterState),value is state))\nthread=threading.Thread(target=read_other)\nthread.start()\nthread.join()\nassert other==[(True,False)]\n"
    },
