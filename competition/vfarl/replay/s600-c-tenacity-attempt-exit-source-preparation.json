  "mechanism_evidence": {
    "trigger": "Exit a retry-attempt context after an exception and after successful work.",
    "base_wrong_behavior": "An exception is recorded as a result and propagates; the success branch attempts to store a missing exception.",
    "production_symbols": "AttemptManager.__exit__",
    "causal_change": "Capture and suppress an actual exception as the retry outcome, and record None as the success result.",
    "discriminating_observation": {
      "kind": "explicitly_reviewed_source_bound_inline_execution",
      "description": "from tenacity import RetryCallState, Retrying\nstate=RetryCallState(Retrying(),None,(),{})\nfrom tenacity import AttemptManager\ncause=ValueError('retryable')\nwith AttemptManager(state):\n raise cause\nassert state.outcome.failed and state.outcome.exception() is cause\nother=RetryCallState(Retrying(),None,(),{})\nwith AttemptManager(other):\n pass\nprint('attempt_outcomes',state.outcome.failed,other.outcome.failed,other.outcome.result())\nassert other.outcome.failed is False and other.outcome.result() is None\n"
    },
