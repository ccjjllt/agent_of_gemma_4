#!/bin/sh
# Wide-terminal shim for the mypy pretty-printer used by
# tests/mypy/test_type_annotations.py. Pinned single-line expectations assume
# no line wrapping (reference env); without a tty mypy defaults to width 80
# and wraps, breaking message comparison on ANY tree. Repair behavior itself
# is verified by the transformer tests and mypy message content.
export COLUMNS=250
export TERM="${TERM:-xterm}"
exec /Users/zhaohuaxiang/ccjjllt/agent_of_gemma_4/competition/vfarl/replay/.venv-typeguard/bin/mypy "$@"
