  "mechanism_evidence": {
    "trigger": "Filter explicit Meta exclusions separately from optionally excluded dump-only fields.",
    "base_wrong_behavior": "Meta.exclude and dump_only channels are crossed and the unfiltered input is returned.",
    "production_symbols": "filter_excluded_fields",
    "causal_change": "Always exclude Meta.exclude, optionally exclude dump-only names/flags and return the filtered mapping.",
    "discriminating_observation": {
      "kind": "explicitly_reviewed_source_bound_inline_execution",
      "description": "from marshmallow import fields\nfrom apispec.ext.marshmallow.common import filter_excluded_fields\nclass Meta:\n exclude=['hidden']\n dump_only=['meta_output']\nvalues={'visible':fields.String(),'hidden':fields.String(),'output':fields.String(dump_only=True),'meta_output':fields.String()}\nall_fields=filter_excluded_fields(values,Meta,exclude_dump_only=False)\ninput_fields=filter_excluded_fields(values,Meta,exclude_dump_only=True)\nprint('filtered_field_names',list(all_fields),list(input_fields))\nassert set(all_fields)=={'visible','output','meta_output'}\nassert set(input_fields)=={'visible'}\n"
    },
