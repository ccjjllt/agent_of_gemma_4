  "mechanism_evidence": {
    "trigger": "Obtain fields from an initialized Schema instance and from a Schema class.",
    "base_wrong_behavior": "Instance fields are unnecessarily deep-copied, class fields remain shared and dump-only filtering is reversed.",
    "production_symbols": "get_fields",
    "causal_change": "Preserve instance-owned field identity, copy class declarations and pass the original exclusion flag.",
    "discriminating_observation": {
      "kind": "explicitly_reviewed_source_bound_inline_execution",
      "description": "from marshmallow import Schema,fields\nfrom apispec.ext.marshmallow.common import get_fields\nclass Item(Schema):\n value=fields.Integer()\n output=fields.String(dump_only=True)\ninstance=Item()\ninstance_fields=get_fields(instance)\nclass_fields=get_fields(Item)\nprint('field_ownership',instance_fields['value'] is instance.fields['value'],class_fields['value'] is Item._declared_fields['value'])\nassert instance_fields['value'] is instance.fields['value']\nassert class_fields['value'] is not Item._declared_fields['value']\nassert 'output' not in get_fields(Item,exclude_dump_only=True)\n"
    },
    "bug_patch_direction": "introduces_defect_not_a_repair_target"
