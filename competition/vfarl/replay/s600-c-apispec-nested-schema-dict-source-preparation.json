  "mechanism_evidence": {
    "trigger": "Resolve a real Marshmallow schema class inside an array item schema.",
    "base_wrong_behavior": "Array items are left unresolved or written under an unrelated not_items key.",
    "production_symbols": "SchemaResolver.resolve_schema_dict",
    "causal_change": "Recursively resolve array items, object properties and composed schemas in their original schema keys.",
    "discriminating_observation": {
      "kind": "explicitly_reviewed_source_bound_inline_execution",
      "description": "from apispec import APISpec\nfrom apispec.ext.marshmallow import MarshmallowPlugin\nfrom marshmallow import Schema,fields,validate\nplugin=MarshmallowPlugin()\nspec=APISpec(title='demo',version='1',openapi_version='3.0.3',plugins=[plugin])\nconverter=plugin.converter\nclass Pet(Schema):\n name=fields.String()\nspec.components.schema('Pet',schema=Pet)\nvalue={'type':'array','items':Pet}\nresult=plugin.resolver.resolve_schema_dict(value)\nprint('resolved_array_items',result)\nassert result['items']=={'$ref':'#/components/schemas/Pet'} and 'not_items' not in result\n"
    },
