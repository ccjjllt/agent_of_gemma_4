  "mechanism_evidence": {
    "trigger": "Access Context.meta twice and mutate one reference.",
    "base_wrong_behavior": "meta returns a detached copy; identity fails and mutations are invisible to the original and other references.",
    "production_symbols": "click.Context.meta",
    "causal_change": "Return the shared live _meta mapping.",
    "discriminating_observation": {
      "kind": "explicitly_reviewed_source_bound_inline_execution",
      "description": "from click import Context, Command\ncmd=Command('probe')\nctx=Context(cmd)\nm1=ctx.meta\nm2=ctx.meta\nprint('meta_identity', m1 is m2, m1 is ctx.meta)\nassert m1 is m2 and m1 is ctx.meta\nm1['f2key']='f2val'\nprint('meta_shared_visible', ctx.meta.get('f2key'), m2.get('f2key'))\nassert ctx.meta.get('f2key')=='f2val'\nassert m2.get('f2key')=='f2val'\nassert ctx.meta is m1\nprint('meta_shared_ownership', True)\n"
    },
    "bug_patch_direction": "introduces_defect_not_a_repair_target"
  },
