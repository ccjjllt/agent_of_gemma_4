      "family": "pallets/click::click.decorators.argument+option::reusable_decorator_shared_attrs_isolation",
      "contract": "Reusable argument/option decorator factories never mutate the shared closure attrs mapping: each application owns its params; repeated applications yield identical classes; captured at the decorator-application timepoint.",
      "trigger": "Apply the same cls= decorator factory to two commands.",
      "base_wrong_behavior": "Inner decorator pops cls from the shared attrs dict; the second application silently gets the default class.",
      "production_symbols": [
        "click.decorators.argument",
        "click.decorators.option"
      ],
      "causal_change": "cls promoted to an explicit factory parameter; inner decorator performs zero mutation of attrs.",
      "discriminating_observation": {
        "kind": "explicitly_reviewed_source_bound_inline_execution",
        "description": "import click\nclass CustomArgument(click.Argument):\n    pass\nreusable = click.argument('art', cls=CustomArgument)\n@click.command()\n@reusable\ndef foo(arg):\n    pass\n@click.command()\n@reusable\ndef bar(arg):\n    pass\nprint('params_identity', foo.params[0] is bar.params[0])\nassert foo.params[0] is not bar.params[0]\nassert isinstance(foo.params[0], CustomArgument)\nassert isinstance(bar.params[0], CustomArgument)\nprint('f2_decorator_isolation', True)\n"
      },
      "triple": {
        "is_identity": "foo.params[0] is not bar.params[0] (per-application owned params)",
        "shared_mutation_visibility": "first application leaves the shared attrs mapping reusable (second sees cls)",
        "copy_timepoint": "decorator-application timepoint capture"
      },
      "bug_patch_direction": "repair_target",
