  "mechanism_evidence": {
    "trigger": "Clone a retry controller while replacing sleep, wait, retry and callbacks independently.",
    "base_wrong_behavior": "Parameter channels are crossed and several explicit overrides are shadowed by the original value.",
    "production_symbols": "BaseRetrying.copy",
    "causal_change": "Pass each requested parameter to the matching constructor channel, preserving unset fallbacks.",
    "discriminating_observation": {
      "kind": "explicitly_reviewed_source_bound_inline_execution",
      "description": "from tenacity import Retrying,wait_fixed,retry_never,retry_always\nbase_sleep=lambda delay:None\nnew_sleep=lambda delay:None\nnew_after=lambda state:None\nnew_before_sleep=lambda state:None\nold=Retrying(sleep=base_sleep,wait=wait_fixed(1),retry=retry_never)\nnew_wait=wait_fixed(2)\nnew=old.copy(sleep=new_sleep,wait=new_wait,retry=retry_always,after=new_after,before_sleep=new_before_sleep)\nprint('controller_override_bindings',new.sleep is new_sleep,new.wait is new_wait,new.retry is retry_always)\nassert new is not old and new.sleep is new_sleep and new.wait is new_wait\nassert new.retry is retry_always and new.after is new_after and new.before_sleep is new_before_sleep\nassert old.sleep is base_sleep and old.retry is retry_never\n"
    },
