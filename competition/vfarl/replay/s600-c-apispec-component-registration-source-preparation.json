    "discriminating_observation": {
      "kind": "explicitly_reviewed_source_bound_inline_execution",
      "description": "from apispec import APISpec\nspec=APISpec(title='demo',version='1',openapi_version='3.0.3')\ncomponent={'type':'string'}\nspec.components._register_component('schema','Now',component,lazy=False)\nspec.components._register_component('schema','Later',component,lazy=True)\nprint('registration_buffers',list(spec.components.schemas),list(spec.components.schemas_lazy))\nassert spec.components.schemas['Now'] is component\nassert spec.components.schemas_lazy['Later'] is component and 'Later' not in spec.components.schemas\nreference=spec.components.get_ref('schema','Later')\nassert reference=={'$ref':'#/components/schemas/Later'}\nassert spec.components.schemas['Later'] is component and 'Later' not in spec.components.schemas_lazy\n"
    },
