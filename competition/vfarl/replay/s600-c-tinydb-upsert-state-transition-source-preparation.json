  "mechanism_evidence": {
    "trigger": "Upsert with no matching query, then upsert a missing explicit-ID document.",
    "base_wrong_behavior": "The no-update path returns a constant [0] instead of inserting and mishandles missing-ID fallback.",
    "production_symbols": "Table.upsert",
    "causal_change": "Execute the insert transition when no update matched and report the resulting actual document identities.",
    "discriminating_observation": {
      "kind": "explicitly_reviewed_source_bound_inline_execution",
      "description": "from tinydb import TinyDB,where\nfrom tinydb.table import Document\nfrom tinydb.storages import MemoryStorage\ndb=TinyDB(storage=MemoryStorage);t=db.table('records');t.insert({'name':'old'});value=t.upsert({'name':'new'},where('name')=='new');print('upsert_insert_transition',value,t.all())\nassert value==[2] and t.get(doc_id=2)=={'name':'new'}\nvalue=t.upsert(Document({'name':'explicit'},doc_id=7));assert value==[7] and t.get(doc_id=7)=={'name':'explicit'}\n"
    },
    "bug_patch_direction": "introduces_defect_not_a_repair_target"
  },
