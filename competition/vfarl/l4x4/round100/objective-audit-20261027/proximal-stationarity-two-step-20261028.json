  "papers": [
    {
      "url": "https://arxiv.org/html/2610.18738v1",
      "section": "3 Eq3; 5 Theorem1; AppendixE.2 A1-A4",
      "narrow_summary": "Full unmodified future log-ratio credit and current-token IS preserve the proximal stationary policy under finite support, covered histories/actions, target representability, full local log-odds expressiveness, and exact population updates. This is not an unbiased-gradient claim. Clipped costs, finite windows, and practical group normalization are outside that exact field."
    },
    {
      "url": "https://arxiv.org/html/2610.25725v1",
      "section": "4 trajectory regularized return and group-centered field; Remark1; Eq3-Eq4",
      "narrow_summary": "With deterministic transitions, the optimal trajectory regularized return is pathwise constant. Centering that complete return makes the group field vanish at the optimum, independently of behavior weighting. The finite-sample analysis additionally assumes coverage and bounded trajectory log ratios; a bounded tabular logit class containing this optimum satisfies those toy conditions."
    }
